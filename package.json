{
  "name": "dm-workbench",
  "productName": "DM Workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Private Dungeon Master desktop workbench for D&D 5e: worldbuilding, maps, dungeons, encounters and sessions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:nsis": "tauri build --bundles nsis",
    "fmg:install": "node scripts/fmg-install.mjs",
    "fmg:build": "node scripts/fmg-build.mjs",
    "srd:build": "node scripts/build-srd2024.mjs",
    "setup": "npm install && npm run fmg:install && npm run fmg:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
